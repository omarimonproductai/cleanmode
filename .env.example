# Configuració per a l'API REST (Discovery API) de MODE Analytics.
# Copia aquest fitxer a `.env` i omple els valors reals. NO versionis `.env`.

# Nom del workspace/organització a MODE (apareix a la URL: app.mode.com/<workspace>/...)
MODE_WORKSPACE=

# Credencials de l'API (Settings > API Tokens a MODE). S'usen com a usuari:contrasenya (Basic Auth).
MODE_API_TOKEN=
MODE_API_SECRET=
